page {
  background-color: #F4F6F9;
}
.page-container {
  padding-bottom: 60rpx;
}
.filter-section {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 99;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.content-area {
  padding: 20rpx 10rpx;
}

.timetable-container {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

/* 顶部星期栏 */
.time-header {
  display: flex;
  background: #F8F9FA;
  height: 80rpx;
  align-items: center;
  border-bottom: 2rpx solid #eee;
}
.header-placeholder {
  width: 60rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  font-weight: bold;
}
.header-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #555;
  font-weight: bold;
}

.time-body {
  position: relative;
  display: flex;
  height: calc(13 * 160rpx); /* 13节课的总高度 */
}

/* 左侧节次列 */
.sidebar {
  width: 60rpx;
  background: #F8F9FA;
  border-right: 2rpx solid #eee;
}
.sidebar-item {
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

/* 背景虚线格 */
.grid-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.grid-row {
  height: 160rpx;
  border-bottom: 2rpx dashed #f0f0f0;
  box-sizing: border-box;
}

.course-block {
  position: absolute;
  border-radius: 12rpx;
  padding: 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  text-align: center;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  margin-left: 3rpx; 
  margin-top: 3rpx;
}

.block-name {
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1.2;
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-line-clamp: 4; /* 最多显示4行字 */
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.block-room {
  font-size: 18rpx;
  opacity: 0.85;
  line-height: 1.1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tag-time { background: #E8F0FE; color: #1A73E8 !important; }
.tag-room { background: #FCE8E6; color: #D93025 !important; }
.tag-teacher { background: #E6F4EA; color: #1E8E3E !important; }
.tag-weeks { background: #FEF7E0; color: #E37400 !important; }

.detail-header {
  border-bottom: 2rpx dashed #eee;
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
  margin-top: 20rpx;
}
.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  line-height: 1.4;
}
.detail-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx; 
  padding: 0 20rpx;
}
.detail-item {
  display: flex;
  align-items: flex-start;
  font-size: 30rpx;
  line-height: 1.5;
}
.detail-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
}
.detail-label {
  color: #888;
  width: 160rpx;
  flex-shrink: 0;
}
.detail-value {
  color: #333;
  flex: 1;
  font-weight: bold;
}