page {
  background-color: #ffffff;
  padding-bottom: env(safe-area-inset-bottom);
}

.container {
  padding: 0;
}

/* 1. 头部用户信息 */
.header-row {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f2f2f2;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.meta-info {
  font-size: 24rpx;
  color: #999;
}

/* 2. 正文 */
.content-text {
  padding: 10rpx 30rpx;
  font-size: 32rpx;
  color: #333;
  line-height: 1.7;
  text-align: justify;
}

/* 3. 图片 */
.image-box {
  padding: 20rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
}

.post-img.grid {
  width: 220rpx;
  height: 220rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
  border-radius: 8rpx;
  background: #f8f8f8;
}
.post-img.grid:nth-child(3n) {
  margin-right: 0;
}
.post-img.single {
  max-width: 100%;
  border-radius: 12rpx;
}

/* 4. 标签 */

.footer-tool-bar {
  display: flex;
  justify-content: space-between; /* 关键：左边一个，右边一堆 */
  align-items: center;            /* 垂直居中对齐 */
  padding: 30rpx 30rpx;           /* 上下留足呼吸感 */
}

/* 左侧标签样式 */
.tag-pill {
  display: inline-block;
  background: #f2f3f5;
  color: #666;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  flex-shrink: 0; /* 防止被挤压 */
}

/* 右侧按钮组容器 */
.action-group {
  display: flex;
  align-items: center;
}

/* 单个按钮样式 */
.action-btn {
  display: flex;
  align-items: center;
  background: transparent;
  padding: 0;
  line-height: 1;
  margin-left: 40rpx; /* 按钮之间的间距 */
  font-size: 26rpx;
  color: #666;
}

/* 去除 button 默认边框 */
.action-btn::after { border: none; }

/* 图标和文字的间距 */
.action-btn text { 
  margin-left: 8rpx; 
}

/* 点赞激活态 */
.action-btn.active text { 
  color: #ff4d4f; 
}
/* 粗灰分隔条 */
.divider-gap {
  height: 16rpx;
  background-color: #f7f8fa;
  width: 100%;
}

/* 6. 评论区 */
.comment-section {
  padding: 30rpx;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.sort-tabs {
  font-size: 24rpx;
  color: #999;
}
.sort-tabs .active {
  color: #333;
  font-weight: bold;
}

/* 空状态 */
.empty-comment {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.empty-text {
  font-size: 26rpx;
  color: #ccc;
  margin-top: 20rpx;
}

/* 7. 底部固定栏 */

  .bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #ffffff;
    border-top: 1rpx solid #f0f0f0;
    padding: 16rpx 30rpx;
    padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); 
    display: flex;
    align-items: center;
    box-sizing: border-box;
    z-index: 99; 
  }


.my-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eee;
}

.input-fake-box {
  flex: 1;
  background: #f7f8fa;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  color: #999;
  font-size: 28rpx;
}

.loading-center {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}
.popup-content {
  display: flex;
  flex-direction: column;
}

/* 标题 */
.popup-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

/* 输入框区域背景（淡灰色） */
.input-area {
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.comment-textarea {
  width: 100%;
  height: 160rpx; /* 高度适中 */
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 图片上传区 */
.upload-area {
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

/* 开关行 */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 50rpx;
}

.switch-label {
  font-size: 28rpx;
  color: #666;
}

/* 覆盖 Vant 上传组件的默认样式，让它看起来像截图里的虚线框 */
.van-uploader__upload {
  background-color: #f7f8fa !important;
  border: 2rpx dashed #ccc !important;
  border-radius: 12rpx !important;
}

.comment-list {
  margin-top: 20rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 40rpx; /* 每条评论之间的间距 */
}

/* 左侧小头像 */
.c-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #f0f0f0;
  flex-shrink: 0; /* 防止被挤压 */
}

/* 右侧内容区 */
.c-box {
  flex: 1;
  border-bottom: 1rpx solid #f9f9f9; /* 加个极淡的底部分割线 */
  padding-bottom: 30rpx;
}


.c-time {
  font-size: 22rpx;
  color: #bbb;
}

.c-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  text-align: justify;
}

/* 评论图片 */
.c-imgs {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.c-img-item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  background-color: #f4f4f4;
}

.no-more {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 30rpx 0;
}

.c-top {
  display: flex;
  justify-content: space-between; 
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.c-user-meta {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.c-top-right {
  display: flex;
  align-items: center;
}

.c-nickname {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 4rpx;
}

/* 评论点赞按钮样式 */
.c-like-btn {
  display: flex;
  align-items: center;
  padding: 10rpx;
  margin-right: 10rpx; /* 给三个点留点距离 */
}

.c-like-num {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 底部右下角操作区 */
.c-bottom-actions {
  display: flex;
  justify-content: flex-end; /* 靠右对齐 */
  margin-top: 10rpx;
}

.c-more-btn {
  padding: 10rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.more-btn {
  padding: 10rpx 0 10rpx 30rpx; /* 增大触控区域 */
}

.menu-container {
  background: #f7f8fa;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.menu-header {
  padding: 30rpx;
  text-align: left;
  font-size: 28rpx;
  color: #999;
  font-weight: bold;
  background: #fff;
}

/* 宫格布局 */
.menu-grid {
  display: flex;
  padding: 20rpx 0 40rpx;
  background: #fff;
}

.menu-item {
  flex: 1; /* 等分宽度 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.menu-item::after { border: none; }

.menu-icon-box {
  width: 90rpx;
  height: 90rpx;
  background: #f2f3f5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.menu-text {
  font-size: 24rpx;
  color: #666;
}

/* 取消按钮 */
.menu-cancel {
  margin-top: 16rpx;
  background: #fff;
  text-align: center;
  padding: 30rpx;
  font-size: 30rpx;
  color: #333;
}

.author-tag {
  font-size: 18rpx;
  color: #8c939d;
  border: 1rpx solid #dcdfe6;
  padding: 0 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  line-height: 1.4;
  background-color: #f4f4f5;
}

.replies-box {
  background: #f7f8fa; /* 灰底色 */
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.reply-item {
  margin-bottom: 24rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.reply-user-meta {
  display: flex;
  align-items: center;
}

.reply-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.reply-nickname {
  font-size: 24rpx;
  color: #555;
  font-weight: 500;
}

.reply-like-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 0 10rpx 20rpx;
}

.reply-content {
  font-size: 26rpx;
  color: #333;
  margin-left: 52rpx; /* 对齐头像右侧 */
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.reply-to {
  color: #1989fa; /* 蓝色的 回复@xx */
}

.reply-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-left: 52rpx; /* 对齐内容 */
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.custom-sort-toggle {
  display: flex;
  background-color: #F2F2F2; /* 浅灰底色 */
  border-radius: 12rpx;
  padding: 6rpx;
}

.toggle-item {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 28rpx;
  border-radius: 8rpx;
  transition: all 0.3s; /* 丝滑过渡动画 */
}

/* 被选中的高亮滑块样式 */
.toggle-item.active {
  background-color: #FFFFFF;
  color: #4F7BFC; /* 你的蓝色主题色，你可以改成 #54658B 之类的 */
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05); /* 模拟悬浮感 */
}