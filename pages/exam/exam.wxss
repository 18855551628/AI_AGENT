page {
  background-color: #F4F6F9;
}
.page-container {
  padding-bottom: 40rpx;
}

/* 筛选区 */
.filter-section {
  position: sticky;
  top: 0;
  z-index: 99;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}
.result-summary {
  padding: 16rpx 30rpx;
  background: #F8F9FA;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  border-top: 2rpx solid #eee;
}
.highlight-num {
  color: #4F7BFC;
  font-weight: bold;
  font-size: 28rpx;
  margin: 0 6rpx;
}

/* 列表区 */
.content-area {
  padding: 24rpx 30rpx;
}

/* 考场卡片设计 */
.exam-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  border-left: 8rpx solid #4F7BFC;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.course-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.info-row {
  display: flex;
  font-size: 26rpx;
  line-height: 1.4;
}
.info-label {
  color: #888;
  width: 140rpx; /* 固定宽度让冒号对齐 */
}
.info-value {
  color: #333;
  flex: 1;
}
.location-text {
  font-weight: 500;
  color: #2E7D32; /* 地点用绿色强调一下 */
}
.seat-text {
  font-weight: bold;
  color: #E65100; /* 座位号用亮色强调 */
  font-size: 28rpx;
}

/* 标签样式 */
.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: bold;
}
.tag-purple {
  background: #E8F0FE;
  color: #4F7BFC;
}
.tag-gray {
  background: #F5F5F5;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}
.empty-img {
  width: 240rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.9;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
}