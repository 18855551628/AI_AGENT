page {
  background-color: #f7f8fa;
}

.banner swiper {
  width: 100%;
  height: 400rpx; 
}

.banner image {
  width: 100% !important;
  height: 100% !important;
}

/* === Bento Grid 布局容器 === */
.bento-container {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  grid-template-rows: 180rpx 180rpx; 
  gap: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用卡片样式 */
.bento-item {
  border-radius: 24rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); 
}

/* === 左侧大卡片 (课程) === */
.main-card {
  grid-row: span 2;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1px solid #f0f0f0;
}

.tag {
  background: #e6f7ff;
  color: #1890ff; 
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 装饰圆球 */
.bg-circle {
  position: absolute;
  bottom: -40rpx;
  right: -40rpx;
  width: 150rpx;
  height: 150rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border-radius: 50%;
  opacity: 0.6;
  z-index: 0;
}

/* === 右侧小卡片通用 === */
.sub-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.sub-title {
  font-size: 24rpx;
  opacity: 0.9;
  z-index: 1;
}

/* 背景大图标装饰 */
.bg-icon {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  font-size: 80rpx !important; 
  opacity: 0.2;
  transform: rotate(-15deg);
  color: white;
}

.temp {
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1;
}

.weather-text {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.weather-icon {
  opacity: 0.9;
}

.count-number {
  font-size: 56rpx;
  font-weight: bold;
  margin-top: 10rpx;
  line-height: 1;
  z-index: 1;
}

.unit {
  font-size: 24rpx;
  font-weight: normal;
  opacity: 0.8;
  margin-left: 4rpx;
}

/* === 金刚区 (工具栏) === */
.tool-grid {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 24rpx; 
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-bg {
  width: 90rpx;
  height: 90rpx;
  border-radius: 30rpx; 
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

/* 工具图标背景色 */
.bg-blue { background: #e6f7ff; border: 1px solid #91d5ff; }
.bg-blue van-icon { color: #1890ff !important; } 

.bg-purple { background: #f9f0ff; border: 1px solid #d3adf7; }
.bg-purple van-icon { color: #722ed1 !important; }

.bg-green { background: #f6ffed; border: 1px solid #b7eb8f; }
.bg-green van-icon { color: #52c41a !important; }

.bg-orange { background: #fff7e6; border: 1px solid #ffd591; }
.bg-orange van-icon { color: #fa8c16 !important; }

.tool-item text {
  font-size: 24rpx;
  color: #666;
}

/* === 列表标题 === */
.section-title {
  padding: 20rpx 30rpx 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.fortune-card {
  background: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 1px solid #f0f0f0;
  position: relative;
}

/* 未签到：呼吸引导 */
.unchecked-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.anim-icon {
  animation: float 2s ease-in-out infinite;
  margin-bottom: 16rpx;
}
@keyframes float {
  0% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
  100% { transform: translateY(0); }
}
.check-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}
.check-btn {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
}

/* 已签到：运势结果展示 */
.checked-state {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  z-index: 1;
}
.fortune-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.fortune-title {
  font-size: 55rpx;
  font-weight: 800;
}
.points-reward {
  font-size: 24rpx;
  color: #fa8c16;
  font-weight: bold;
  background: #fff7e6;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.fortune-tag {
  display: inline-block;
  font-size: 26rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  margin: 16rpx 0;
}
.fortune-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}
.bg-icon-large {
  position: absolute;
  right: -20rpx;
  bottom: -20rpx;
  font-size: 160rpx !important;
  opacity: 0.05;
  z-index: 0;
}

/* === 右上：积分账户卡片 === */
.points-card {
  background: linear-gradient(135deg, #FFD15C 0%, #FFA836 100%);
  color: white;
  justify-content: space-between;
  padding: 24rpx 30rpx !important;
}
.card-top-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sub-title-light {
  font-size: 24rpx;
  opacity: 0.9;
}
.points-num {
  font-size: 50rpx; 
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 10rpx 0;
}
.coin-icon {
  margin-top: 4rpx;
}
.mall-text {
  font-size: 22rpx;
  background: rgba(255,255,255,0.2);
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  align-self: flex-start;
}

/* === 右下：连续签到成就卡片 === */
.streak-card {
  background: linear-gradient(135deg, #7F71FF 0%, #5B4DF0 100%);
  color: white;
  justify-content: space-between;
  padding: 24rpx 30rpx !important;
}
.streak-info {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
  z-index: 1;
}
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  margin-top: 12rpx;
  overflow: hidden;
  z-index: 1;
}
.progress-inner {
  height: 100%;
  background: #00FFD1;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}
.progress-text {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  z-index: 1;
}
.streak-header {
  position: relative; 
  z-index: 10;
}

.title-with-icon {
  display: flex;
  align-items: center;
  gap: 2rpx; 
}

/* 黑色提示气泡主体 */
.rule-tooltip {
  position: absolute;
  top: 45rpx;
  left: -20rpx;
  background: rgba(0, 0, 0, 0.85); 
  color: #fff;
  font-size: 22rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  width: 220rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  line-height: 1.5;
  z-index: 100;
}

.rule-tooltip::before {
  content: '';
  position: absolute;
  top: -10rpx; 
  left: 40rpx;
  border-width: 0 10rpx 10rpx 10rpx;
  border-style: solid;
  border-color: transparent transparent rgba(0, 0, 0, 0.85) transparent;
}


/* === AI 校园全场景助手卡片 === */
.ai-assistant-card {
  margin: 30rpx 20rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 30rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(24, 144, 255, 0.08);
  border: 1px solid rgba(24, 144, 255, 0.15);
  z-index: 1;
}

/* 科技感流光背景 */
.ai-card-bg {
  position: absolute;
  top: -50%; right: -20%;
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(24,144,255,0.15) 0%, transparent 70%);
  z-index: -1;
  animation: pulse-bg 4s infinite alternate;
}

@keyframes pulse-bg {
  0% { transform: scale(0.8); opacity: 0.5; }
  100% { transform: scale(1.2); opacity: 1; }
}

.ai-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.ai-title {
  display: flex;
  align-items: center;
}

.ai-icon-pulse {
  animation: heartbeat 2s infinite;
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.title-text {
  font-size: 34rpx;
  font-weight: 800;
  margin-left: 12rpx;
  background: linear-gradient(90deg, #1890ff 0%, #722ed1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.ai-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 快捷指令胶囊 */
.ai-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.suggestion-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #f0f7ff;
  color: #1890ff;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-weight: bold;
  border: 1px solid rgba(24,144,255,0.2);
  transition: all 0.2s;
}

.suggestion-pill:active {
  background: #e6f2ff;
  transform: scale(0.95);
}

/* ================= 真实输入框样式 ================= */
.ai-real-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f7f9fc;
  border-radius: 40rpx;
  padding: 8rpx 8rpx 8rpx 30rpx;
  border: 1px solid #eef2f8;
  margin-top: 10rpx;
}

.real-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 64rpx;
}

.real-send-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #d9d9d9; 
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s;
}

/* 输入框有内容时激活发送按钮 */
.real-send-btn.active {
  background: linear-gradient(135deg, #40a9ff 0%, #1890ff 100%);
  box-shadow: 0 4rpx 12rpx rgba(24,144,255,0.3);
}
.real-send-btn.active:active {
  transform: scale(0.9);
}

/* ================= 动态回答展示区样式 ================= */
.ai-response-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* 用户发出的问题气泡 */
.user-query-bubble {
  align-self: flex-end;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #fff;
  padding: 16rpx 24rpx;
  border-radius: 24rpx 24rpx 4rpx 24rpx;
  font-size: 28rpx;
  max-width: 85%;
  word-wrap: break-word;
  box-shadow: 0 4rpx 12rpx rgba(24,144,255,0.2);
}

/* AI 的回答气泡 */
.ai-answer-bubble {
  align-self: flex-start;
  background: #f0f7ff;
  color: #333;
  padding: 24rpx;
  border-radius: 24rpx 24rpx 24rpx 4rpx;
  font-size: 28rpx;
  line-height: 1.6;
  max-width: 95%;
  border: 1px solid rgba(24,144,255,0.1);
  text-align: justify;
}

/* 重新提问操作栏 */
.ai-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1px dashed rgba(24,144,255,0.2);
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #1890ff;
  font-weight: bold;
}

/* AI 思考中气泡 */
.ai-loading-bubble {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f7f9fc;
  color: #1890ff;
  padding: 20rpx 30rpx;
  border-radius: 24rpx 24rpx 24rpx 4rpx;
  font-size: 26rpx;
  border: 1px solid #eef2f8;
}