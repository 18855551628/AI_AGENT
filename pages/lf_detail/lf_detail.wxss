/* pages/lf_detail/lf_detail.wxss */page {
  background-color: #f7f8fa;
}

/* 轮播图 */
.gallery {
  width: 100%;
  height: 600rpx; 
  background: #fff;
}
.slide-image {
  width: 100%;
  height: 100%;
}

/* 卡片通用样式 */
.info-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 标题与标签 */
.title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 16rpx;
  margin-top: 6rpx;
  white-space: nowrap;
}
.found-tag { background: #07c160; }
.lost-tag { background: #ee0a24; }

.title { 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #333; 
  line-height: 1.5; 
  flex: 1;
}

/* 地点与时间 */
.meta-box {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.meta-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 10rpx;
}
.meta-item:last-child {
  margin-bottom: 0;
}
.meta-item .icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}

.view-count { 
  text-align: right; 
  color: #999; 
  font-size: 24rpx; 
}

/* 描述 */
.section-title { 
  font-size: 30rpx; 
  font-weight: bold; 
  margin-bottom: 20rpx; 
  border-left: 8rpx solid #ffd000; 
  padding-left: 20rpx; 
}
.desc-text { 
  font-size: 28rpx; 
  color: #333; 
  line-height: 1.8; 
  word-break: break-all;
}

/* 发布者信息 */
.seller-box { 
  display: flex; 
  align-items: center; 
  border-radius: 0 0 20rpx 20rpx; 
}
.avatar { 
  width: 80rpx; 
  height: 80rpx; 
  border-radius: 50%; 
  background: #eee; 
  margin-right: 20rpx; 
}
.seller-mid { flex: 1; }
.name { font-size: 30rpx; font-weight: bold; }
.tips { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  width: 100%;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 10rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #666;
  margin-right: 40rpx;
  background: transparent;
  padding: 0;
  line-height: 1.2;
}
.action-btn::after { border: none; }
.action-btn .icon { font-size: 36rpx; margin-bottom: 4rpx; }

.contact-btn {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #ffea00, #ffca00);
  color: #333;
  font-weight: bold;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 200, 0, 0.3);
}