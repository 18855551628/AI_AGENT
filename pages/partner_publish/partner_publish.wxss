page {
  background: #F8F9FC;
  padding-bottom: env(safe-area-inset-bottom);
}

.publish-container {
  padding: 30rpx;
}

/* 白色卡片通用样式 */
.form-card, .feature-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 30rpx;
}

/* 表单组 */
.form-group {
  margin-bottom: 40rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #FF4D4F;
  margin-right: 8rpx;
  font-weight: bold;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  padding: 14rpx 36rpx;
  background: #F0F3F8;
  color: #666;
  border-radius: 100rpx;
  font-size: 26rpx;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.tag-item.active {
  background: rgba(102, 126, 234, 0.1);
  color: #667EEA;
  border-color: #667EEA;
  font-weight: 600;
}

/* 文本域 */
.textarea-box {
  position: relative;
  background: #F8F9FC;
  border-radius: 16rpx;
  padding: 24rpx;
}

.content-input {
  width: 100%;
  height: 220rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.word-count {
  position: absolute;
  bottom: 20rpx;
  right: 24rpx;
  font-size: 24rpx;
  color: #999;
}

/* 单行输入框 */
.input-box {
  display: flex;
  align-items: center;
  background: #F8F9FC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.input-icon {
  margin-right: 16rpx;
}

.single-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 100%;
}

/* 底部按钮 */
.bottom-action {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 100rpx;
  font-weight: 700;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(118, 75, 162, 0.3);
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}