page { 
  background-color: #f7f8fa; 
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 200rpx; /* 垂直居中一点 */
}

.footer-tip {
  height: 50rpx; 
  text-align:center; 
  color:#999; 
  font-size:24rpx;
  margin-top: 20rpx;
}

/* --- 以下完全复制 forum.wxss 的卡片样式 --- */
.card {
  background: #ffffff;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.03);
}

.user-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background-color: #eee; margin-right: 24rpx; border: 2rpx solid #f0f0f0; }
.user-info { display: flex; flex-direction: column; }
.nickname { font-size: 30rpx; font-weight: 600; color: #2c3e50; margin-bottom: 6rpx; }
.time { font-size: 22rpx; color: #95a5a6; }
.content { font-size: 30rpx; color: #333; line-height: 1.7; margin-bottom: 24rpx; text-align: justify; }

.footer { display: flex; justify-content: space-between; align-items: center; margin-top: 24rpx; border-top: 1rpx solid #f9f9f9; padding-top: 20rpx; }
.tag-box { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; font-weight: 500; letter-spacing: 1rpx; }
.action-box {
  display: flex; 
}

.action-btn {
  display: flex;
  align-items: center;
  margin-left: 30rpx;
  color: #666;
  font-size: 24rpx;
  background: #f7f8fa;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.iconfont {
  font-size: 25rpx;
  margin-right: 8rpx;
}

.liked {
  color: #ff4d4f; 
}

.count {
  font-size: 25rpx;
  font-weight: 400;
  position: relative;
  top: 0rpx; 
}

.image-grid { display: flex; flex-wrap: wrap; margin-bottom: 20rpx; margin-top: 10rpx; }
.post-img { width: 32%; height: 220rpx; margin-right: 2%; margin-bottom: 12rpx; border-radius: 8rpx; background-color: #f0f0f0; }
.post-img:nth-child(3n) { margin-right: 0; }
.single-img { width: 70%; height: 360rpx; border-radius: 12rpx; }