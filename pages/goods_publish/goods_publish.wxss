page {
  background-color: #f7f8fa;
  padding-bottom: 120rpx; /* 给底部按钮留空 */
}

.section-card {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
}

/* 输入框样式 */
.input-title {
  font-size: 32rpx;
  font-weight: bold;
  height: 80rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 20rpx;
}

.input-desc {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.ph-style { color: #ccc; }

/* 图片网格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.img-item, .upload-btn {
  width: 150rpx;
  height: 150rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  position: relative;
}

.img-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.del-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 34rpx;
  font-size: 24rpx;
}

.upload-btn {
  background: #f8f8f8;
  border: 2rpx dashed #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn .icon {
  font-size: 60rpx;
  color: #ccc;
  font-weight: 300;
}

/* 价格行 */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 90rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.form-row:last-child { border-bottom: none; }

.label { font-size: 30rpx; color: #333; }

.price-input-box {
  display: flex;
  align-items: center;
  color: #ff4d4f;
  font-weight: bold;
  font-size: 32rpx;
}

.price-input-box.gray { color: #999; font-weight: normal; font-size: 28rpx; }

.price-input-box input {
  width: 150rpx;
  text-align: right;
  margin-left: 10rpx;
}

/* 标签通用样式 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.required { color: #ff4d4f; margin-left: 6rpx; }
.sub-text { font-size: 24rpx; color: #999; font-weight: normal; margin-left: 10rpx;}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}

.choice-tag {
  padding: 12rpx 30rpx;
  background: #f5f6f8;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

/* 选中高亮样式 */
.choice-tag.active {
  background: #fff8bd; /* 柠檬黄背景 */
  border-color: #ffd000; /* 边框 */
  color: #333;
  font-weight: bold;
}

/* 底部按钮 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  padding: 20rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 10rpx rgba(0,0,0,0.05);
}

.publish-btn {
  background: linear-gradient(135deg, #ffea00, #ffca00);
  color: #333;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-weight: bold;
  font-size: 30rpx;
}

.input-right {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}