<view class="page-container">
  
  <van-search 
    value="{{ searchKeyword }}" 
    placeholder="搜搜看..." 
    shape="round" 
    background="#f7f8fa" 
    custom-class="my-search-bar"
    bind:change="onSearchChange"
    bind:search="onSearch"
    use-action-slot
  >
    <view slot="action" bind:tap="onSearch" style="padding: 0 20rpx; color: #07c160; font-weight: bold;">搜索</view>
  </van-search>

  <view class="sticky-header">
    <van-tabs active="{{ active }}" bind:change="onTabChange" color="#07c160">
      <van-tab title="最新" name="latest"></van-tab>
      <van-tab title="推荐" name="recommend"></van-tab>
      <van-tab title="表白" name="love"></van-tab>
      <van-tab title="求助" name="help"></van-tab>
      <van-tab title="吐槽" name="speak"></van-tab>
      <van-tab title="提问" name="ask"></van-tab>
    </van-tabs>
  </view>

  <view class="post-list">
    <block wx:for="{{posts}}" wx:key="_id">
      <view class="card" bindtap="gotoDetail" data-id="{{item._id}}" data-liked="{{item.isLiked}}">
        <view class="top-tag" wx:if="{{item.isTop === 1}}">置顶</view>
        <view class="user-row">
          <image class="avatar" src="{{item.avatarUrl}}"></image>
          <view class="user-info">
            <text class="nickname">{{item.nickName}}</text>
            <text class="time">{{item.timeString}}</text>
          </view>
        </view>

        <view class="content">
          <text>{{item.content}}</text>
        </view>

        <view class="image-grid" wx:if="{{item.images && item.images.length > 0}}">
          <block wx:for="{{item.images}}" wx:for-item="imgUrl" wx:for-index="imgIdx" wx:key="*this">
            <image 
              class="post-img {{item.images.length === 1 ? 'single-img' : ''}}" 
              src="{{imgUrl}}" 
              mode="aspectFill" 
              catchtap="previewImage" 
              data-urls="{{item.images}}" 
              data-current="{{imgUrl}}"
            ></image>
          </block>
        </view>

        <view class="footer">
          <view class="tag-box" style="{{item.tagStyle}}">
            <text># {{item.tagName}}</text>
          </view>

          <view class="action-box">
            <view class="action-btn" catchtap="onLike" data-idx="{{index}}">
              <van-icon class="iconfont"
  name="{{ item.isLiked ? 'like' : 'like-o' }}" 
  color="{{ item.isLiked ? '#ee0a24' : '#666' }}" 
  size="30rpx"
  custom-style="position: relative; top: -3rpx;"
/>
              <text class="count">{{item.like_count || 0}}</text>
            </view>
            <view class="action-btn">
              <text class="iconfont">评论</text>
              <text class="count">{{item.comment_count || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    
    <view style="height: 150rpx; text-align: center; color: #999; font-size: 24rpx; padding-top: 20rpx;">
      <text wx:if="{{isLoading && posts.length > 0}}">正在加载更多...</text>
      <text wx:elif="{{!hasMore && posts.length > 0}}">- 到底啦 -</text>
    </view>
  </view>

</view>

<movable-area class="fab-overlay">
  <movable-view 
    x="{{movableX}}" 
    y="{{movableY}}" 
    direction="all" 
    class="fab-container"
  >
    <view class="sub-menu-list {{isFabOpen ? 'open' : ''}}">
      <view class="sub-btn" catchtap="gotoMyPosts">
        <text class="sub-text">帖子</text>
        <view class="sub-icon" style="background: #1890ff;">📝</view>
      </view>
      <view class="sub-btn" catchtap="gotoMyLikes">
        <text class="sub-text">喜欢</text>
        <view class="sub-icon" style="background: #ff4d4f;">❤</view>
      </view>
      <view class="sub-btn" catchtap="gotoPublish">
        <text class="sub-text">发布</text>
        <view class="sub-icon" style="background: #07c160;">+</view>
      </view>
    </view>

    <view class="fab-main-btn {{isFabOpen ? 'active' : ''}}" catchtap="toggleFab">
      <text class="main-icon">+</text>
    </view>
  </movable-view>
</movable-area>