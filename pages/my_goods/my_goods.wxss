page { background: #f7f8fa; padding: 20rpx; }
.manage-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
}
.card-main { display: flex; margin-bottom: 20rpx; }
.thumb { width: 140rpx; height: 140rpx; border-radius: 10rpx; margin-right: 20rpx; background: #eee; }
.info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.title { font-size: 30rpx; font-weight: bold; color: #333; }
.price { font-size: 32rpx; color: #ff4d4f; font-weight: bold; }
.status { font-size: 24rpx; color: #999; }

.action-bar {
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}
.status-on { color: #52c41a; } /* 绿色代表在售 */
.status-off { color: #999; }    /* 灰色代表下架 */

/* 按钮通用样式补全 */
.btn {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.off-shelf {
  background: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffd591;
}

.on-shelf {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}