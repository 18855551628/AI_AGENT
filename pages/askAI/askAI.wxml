<view class="chat-container">
  
  <scroll-view class="chat-list" scroll-y="true" scroll-into-view="{{scrollToId}}" scroll-with-animation>
    <block wx:for="{{messageList}}" wx:key="index">
      <view class="msg-row {{item.type === 'user' ? 'msg-right' : 'msg-left'}}" id="msg-{{index}}">
        
        <view class="avatar ai-avatar" wx:if="{{item.type === 'ai'}}">
          <image class="avatar-img" src="/images/ai_avater.png" mode="aspectFill"></image>
        </view>

        <view class="bubble {{item.type === 'user' ? 'user-bubble' : 'ai-bubble'}}">
          <text user-select="true">{{item.text}}</text>
        </view>

        <view class="avatar user-avatar" wx:if="{{item.type === 'user'}}">
          <image class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" wx:if="{{userInfo && userInfo.avatarUrl}}"></image>
          <van-icon name="user-o" size="20px" color="#fff" wx:else />
        </view>

      </view>
    </block>

    <view class="msg-row msg-left" wx:if="{{isTyping}}" id="msg-typing">
      <view class="avatar ai-avatar">
        <image class="avatar-img" src="/images/ai_avater.png" mode="aspectFill"></image>
      </view>
      <view class="bubble ai-bubble typing-bubble">
        <van-loading type="spinner" size="16px" color="#1890ff" />
        <text style="margin-left:10rpx;">AI 助手正在处理中...</text>
      </view>
    </view>
    
    <view class="scroll-pad"></view>
  </scroll-view>

  <view class="input-bar">
    <block wx:if="{{isLoggedIn}}">
      <view class="input-wrap">
        <input
          class="chat-input"
          value="{{inputValue}}"
          placeholder="发送指令"
          bindinput="onInput"
          bindconfirm="sendMessage"
          confirm-type="send"
          cursor-spacing="20"
        />
      </view>
      <view class="send-btn {{inputValue.trim().length > 0 ? 'active' : ''}}" bindtap="sendMessage">
        发送
      </view>
    </block>
    <block wx:else>
      <view class="login-prompt" bindtap="goToLogin">
        <text>请先登录</text>
      </view>
    </block>
  </view>

</view>