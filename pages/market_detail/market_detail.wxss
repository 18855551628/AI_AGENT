page {
  background-color: #f7f8fa;
}

/* 轮播图 */
.gallery {
  width: 100%;
  height: 600rpx; /* 高度给足，展示细节 */
  background: #fff;
}
.slide-image {
  width: 100%;
  height: 100%;
}

/* 卡片通用样式 */
.info-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 价格与标题 */
.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.price { color: #ff4d4f; font-size: 48rpx; font-weight: bold; }
.symbol { font-size: 28rpx; }
.original-price { color: #999; text-decoration: line-through; margin-left: 20rpx; font-size: 26rpx; }
.view-count { margin-left: auto; color: #999; font-size: 24rpx; }

.title { font-size: 34rpx; font-weight: bold; color: #333; line-height: 1.5; margin-bottom: 20rpx; }

/* 标签 */
.tags-row { display: flex; flex-wrap: wrap; }
.tag-item {
  background: #fff8bd;
  color: #333;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 10rpx;
}

/* 描述 */
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; border-left: 8rpx solid #ffd000; padding-left: 20rpx; }
.desc-text { font-size: 28rpx; color: #666; line-height: 1.8; }

/* 卖家信息 */
.seller-box { display: flex; align-items: center; border-radius: 0 0 20rpx 20rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #eee; margin-right: 20rpx; }
.seller-mid { flex: 1; }
.name { font-size: 30rpx; font-weight: bold; }
.tips { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  width: 100%;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 10rpx rgba(0,0,0,0.05);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 20rpx;
  color: #666;
  margin-right: 40rpx;
}
.action-btn .icon { font-size: 36rpx; margin-bottom: 4rpx; }

.contact-btn {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #ffea00, #ffca00);
  color: #333;
  font-weight: bold;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}