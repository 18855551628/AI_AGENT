<view class="container">
  
  <view class="avatar-section">
    <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <van-image round width="160rpx" height="160rpx" src="{{ userInfo.avatarUrl || 'https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCJ1aPAK2dQagdusBZg/0' }}" />
      <view class="camera-icon"><van-icon name="photograph" color="#fff" size="18px" /></view>
    </button>
    <text class="tip-text">点击修改头像</text>
  </view>

  <van-cell-group inset custom-class="form-group">
    <van-field label="昵称" input-align="right">
      <input slot="input" type="nickname" class="wechat-input" placeholder="点击获取微信昵称" value="{{ userInfo.nickName }}" bindchange="onNicknameChange"/>
    </van-field>

    <van-field
      value="{{ userInfo.college }}"
      label="所属学院"
      placeholder="例如：计算机学院"
      input-align="right"
      bind:change="onCollegeChange"
    />

    <van-field
      value="{{ userInfo.grade }}"
      label="入学年份"
      placeholder="请选择入学年份"
      input-align="right"
      readonly
      is-link
      bind:click-input="showGradePicker"
    />

    <van-field
      value="{{ userInfo.gender }}"
      label="性别"
      placeholder="请选择性别"
      input-align="right"
      readonly
      is-link
      bind:click-input="showGenderPicker"
    />

    <van-field
      value="{{ userInfo.dormArea }}"
      label="宿舍区"
      placeholder="请选择宿舍区"
      input-align="right"
      readonly
      is-link
      bind:click-input="showDormAreaPicker"
    />

    <van-field
      value="{{ userInfo.dormNumber }}"
      label="宿舍号"
      placeholder="例如：3栋201"
      input-align="right"
      bind:change="onDormNumberChange"
    />

    <van-field
      value="{{ userInfo.wechatId }}"
      label="微信号"
      placeholder="请输入微信号"
      input-align="right"
      bind:change="onWechatIdChange"
    />
  </van-cell-group>

  <van-popup
    show="{{ showGradePicker }}"
    position="bottom"
    round
    bind:close="onClosePicker"
  >
    <van-picker
      show-toolbar
      title="选择入学年份"
      columns="{{ gradeColumns }}"
      bind:cancel="onClosePicker"
      bind:confirm="onConfirmGrade"
    />
  </van-popup>

  <van-popup
    show="{{ showGenderPicker }}"
    position="bottom"
    round
    bind:close="onCloseGenderPicker"
  >
    <van-picker
      show-toolbar
      title="选择性别"
      columns="{{ genderColumns }}"
      bind:cancel="onCloseGenderPicker"
      bind:confirm="onConfirmGender"
    />
  </van-popup>

  <van-popup
    show="{{ showDormAreaPicker }}"
    position="bottom"
    round
    bind:close="onCloseDormAreaPicker"
  >
    <van-picker
      show-toolbar
      title="选择宿舍区"
      columns="{{ dormAreaColumns }}"
      bind:cancel="onCloseDormAreaPicker"
      bind:confirm="onConfirmDormArea"
    />
  </van-popup>

  <view class="btn-area">
    <van-button round block color="#667eea" bind:click="saveProfile">保存修改</van-button>
  </view>
</view>