page {
  background-color: #f7f8fa;
}

.header-box {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center; 
  justify-content: space-between;
}
.search-bar {
  flex: 1;
  background-color: #f0f2f5;
  height: 70rpx;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin-right: 20rpx; 
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  margin-left: 15rpx;
  color: #333;
}

.search-btn {
  font-size: 30rpx;
  color: #333; 
  font-weight: bold;
  padding: 10rpx 0; 
}

/* 分类 */
.category-scroll-box {
  background: #fff;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}
.category-scroll {
  display: flex;
  white-space: nowrap;
  padding: 0 20rpx; 
  height: 60rpx;
  width: 100%;
  box-sizing: border-box;
}
.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.category-item.active {
  color: #333;
  font-weight: bold;
  font-size: 30rpx;
}
.category-item .dot {
  width: 8rpx;
  height: 8rpx;
  background-color: #ffd000;
  border-radius: 50%;
  position: absolute;
  bottom: -10rpx;
}

/* 瀑布流 */
.waterfall-container {
  column-count: 2; 
  column-gap: 20rpx; 
  padding: 0 20rpx 120rpx 20rpx; 
}

.goods-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  break-inside: avoid; 
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.img-box {
  position: relative;
  width: 100%;
}
.goods-img {
  width: 100%; 
  display: block;
}
.status-tag {
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 18rpx; 
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  backdrop-filter: blur(4px);
}

.content-box { padding: 16rpx; }
.title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}
.current-price { color: #ff4d4f; font-weight: bold; }
.current-price .symbol { font-size: 24rpx; }
.current-price .num { font-size: 36rpx; }
.original-price {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.seller-info {
  display: flex;
  align-items: center;
  justify-content: space-between; /* 关键：一左一右 */
  margin-top: 10rpx; /* 给上面留点空隙 */
}

/* 左侧容器 */
.seller-left {
  display: flex;
  align-items: center;
  /* 防止名字太长挤没了热度，限制一下宽度 */
  max-width: 65%; 
}

/* 保持原来的头像样式 */
.avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background-color: #eee;
  flex-shrink: 0; /* 头像不许被挤压 */
}

/* 保持原来的名字样式 */
.seller-name {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.heat-box {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #ff6b00; 
  background: #fff5e6; 
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.heat-icon {
  font-size: 20rpx;
  margin-right: 4rpx;
}

.heat-num {
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}

.fab-btn {
  position: fixed;
  right: 30rpx;
  bottom: 60rpx;
  background: linear-gradient(135deg, #ffea00, #ffca00);
  color: #333;
  width: 240rpx;  
  justify-content: center; 
  padding: 0;   
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 200, 0, 0.4);
  z-index: 200;
  font-weight: bold;
  box-sizing: border-box; 
}
.plus-icon {
  font-size: 40rpx;
  margin-right: 10rpx;
  margin-top: -4rpx;
}
.tags-container {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  display: flex; 
  flex-wrap: wrap; 
  gap: 8rpx; 
  z-index: 10;
}
.my-btn {
  bottom: 170rpx;
  background: #fff;
  color: #333;
  border: 1rpx solid #eee;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05); 
}