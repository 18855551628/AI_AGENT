page { background-color: #f7f8fa; }
.page-container { padding-bottom: 60rpx; }
.header { padding: 40rpx 32rpx 20rpx; }
.title { font-size: 40rpx; font-weight: 500; color: #333; display: block; }
.subtitle { font-size: 26rpx; color: #999; margin-top: 10rpx; display: block; }
.van-cell-group__title { padding: 30rpx 32rpx 16rpx !important; font-size: 26rpx !important; color: #666 !important; }
.button-wrap { margin: 60rpx 32rpx; }

/* 结果弹窗样式 */
.result-box { padding: 50rpx 40rpx; display: flex; flex-direction: column; }
.result-header { text-align: center; margin-bottom: 50rpx; }
.total-score { font-size: 110rpx; font-weight: bold; color: #1890ff; line-height: 1.1; }
.score-grade { font-size: 30rpx; margin-top: 16rpx; font-weight: bold; }
.pass { color: #07c160; }
.fail { color: #ee0a24; }

.breakdown-title { font-size: 26rpx; color: #888; margin-bottom: 20rpx; border-bottom: 1px dashed #eee; padding-bottom: 16rpx; }
.breakdown-item { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 28rpx; color: #666; }
.item-score { font-weight: bold; color: #333; }