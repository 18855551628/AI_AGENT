/* pages/bind_account/bind_account.wxss */page {
  background-color: #F7F8FA;
}

.page-container {
  padding: 60rpx 40rpx;
}

/* 头部排版 */
.header {
  margin-bottom: 60rpx;
}
.title {
  font-size: 56rpx;
  font-weight: bold;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}
.subtitle {
  font-size: 28rpx;
  color: #888888;
}

/* 表单卡片样式 */
.form-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 10rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 60rpx;
  overflow: hidden; /* 确保子组件不会超出圆角 */
}

/* 深度覆盖 Vant field 的默认背景色，确保与卡片融为一体 */
.form-card .van-cell {
  background-color: transparent !important;
}

/* 按钮区域 */
.btn-wrap {
  margin-bottom: 40rpx;
}

/* 隐私提示 */
.privacy-tip {
  display: flex;
  align-items: flex-start;
  padding: 0 20rpx;
}
.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
}
.privacy-tip text:last-child {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
  flex: 1;
}